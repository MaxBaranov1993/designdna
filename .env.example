# Text/vision: the app can use the current Codex Desktop login automatically.
# Leave CODEX_API_KEY empty to read %USERPROFILE%\\.codex\\auth.json at request time.
# Set CODEX_API_KEY only when you explicitly want an OpenAI-compatible API key.
CODEX_API_KEY=
CODEX_BASE_URL=https://api.openai.com/v1
CODEX_MODEL=gpt-5.6-sol
# Optional explicit path override (never put the token itself here):
# CODEX_AUTH_FILE=C:\\Users\\you\\.codex\\auth.json
# Optional per-role chains (comma-separated):
# CODEX_MODELS_GENERATOR=gpt-5.6-sol

# Optional imagePrompt -> asset service. Accepts JSON prompt/width/height and
# may return {src}, {url}, or OpenAI-style {data:[{url|b64_json}]}.
DESIGNAI_ASSET_ENDPOINT=
DESIGNAI_ASSET_KEY=
DESIGNAI_ASSET_TIMEOUT_S=45

# Video is isolated from text/vision and will use Seedance only.
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_URL=
