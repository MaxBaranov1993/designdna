{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "design-system-1.0",
  "title": "Design System Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "projectId", "name", "status", "revision", "foundations", "components"],
  "properties": {
    "schemaVersion": { "const": "design-system/1.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "projectId": { "type": "string", "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "status": { "enum": ["draft", "published", "outdated", "archived"] },
    "revision": { "type": "integer", "minimum": 0 },
    "contentHash": { "type": "string", "maxLength": 71 },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "sourceNodeId": { "type": ["string", "integer"] },
          "revisionHash": { "type": "string", "maxLength": 71 },
          "url": { "type": "string", "maxLength": 1000 },
          "capturedAt": { "type": "string", "maxLength": 40 }
        },
        "required": ["sourceNodeId"]
      }
    },
    "foundations": { "$ref": "#/$defs/foundations" },
    "components": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/component" }
    },
    "patterns": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": true,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "origin": { "enum": ["observed", "inferred", "generated"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "mockData": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schemas": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": true,
            "required": ["id", "fields"],
            "properties": {
              "id": { "type": "string", "maxLength": 64 },
              "locale": { "type": "string", "maxLength": 12 },
              "fields": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
            }
          }
        },
        "fixtures": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": true,
            "required": ["id", "schemaId", "seed", "profile"],
            "properties": {
              "id": { "type": "string", "maxLength": 80 },
              "schemaId": { "type": "string", "maxLength": 64 },
              "locale": { "type": "string", "maxLength": 12 },
              "seed": { "type": "integer", "minimum": 0 },
              "profile": { "enum": ["typical", "short", "long", "empty", "loading", "error", "edge-case"] }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "usageModes": { "type": "array", "items": { "enum": ["strict", "extend", "style-only"] } }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "observedCount": { "type": "integer", "minimum": 0 },
        "inferredCount": { "type": "integer", "minimum": 0 },
        "generatedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "quality": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "stateCoverage": { "type": "number", "minimum": 0, "maximum": 100 },
        "issues": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    }
  },
  "$defs": {
    "foundations": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "colors": {
          "type": "object", "additionalProperties": true,
          "properties": {
            "primitives": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 32 } },
            "semantic": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 32 } }
          }
        },
        "typography": {
          "type": "object", "additionalProperties": true,
          "properties": {
            "families": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
            "scale": { "type": "object", "additionalProperties": { "type": "number" } },
            "weights": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 900 } }
          }
        },
        "spacing": { "type": "object", "additionalProperties": { "type": "number" } },
        "radii": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "shadows": { "type": "array", "items": { "type": "string", "maxLength": 300 } },
        "breakpoints": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "containers": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "iconStyle": { "type": "string", "maxLength": 200 },
        "imageDirection": { "type": "string", "maxLength": 500 }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["componentKey", "name", "category", "origin", "templateIr"],
      "properties": {
        "componentKey": { "type": "string", "maxLength": 80 },
        "name": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 1000 },
        "origin": { "enum": ["observed", "inferred", "generated"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confirmed": { "type": "boolean" },
        "templateIr": { "type": "object" },
        "propsSchema": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": true,
            "required": ["type"],
            "properties": {
              "type": { "enum": ["string", "number", "boolean", "enum", "iri"] },
              "enum": { "type": "array", "items": { "type": "string", "maxLength": 60 } },
              "required": { "type": "boolean" },
              "description": { "type": "string", "maxLength": 300 }
            }
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "maxLength": 60 },
              "description": { "type": "string", "maxLength": 300 },
              "allowed": { "type": "array", "items": { "type": "string", "maxLength": 60 } }
            }
          }
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": true,
            "required": ["label"],
            "properties": {
              "label": { "type": "string", "maxLength": 80 },
              "origin": { "enum": ["observed", "inferred", "generated"] },
              "diff": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": true,
            "required": ["label", "origin"],
            "properties": {
              "label": { "type": "string", "maxLength": 60 },
              "origin": { "enum": ["observed", "inferred", "generated"] },
              "confirmed": { "type": "boolean" },
              "description": { "type": "string", "maxLength": 300 }
            }
          }
        },
        "dependencies": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
        "tokenBindings": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 120 } },
        "mockBindings": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": true,
            "required": ["schemaId"],
            "properties": { "schemaId": { "type": "string", "maxLength": 64 }, "field": { "type": "string", "maxLength": 60 } }
          }
        },
        "accessibility": {
          "type": "object", "additionalProperties": true,
          "properties": {
            "role": { "type": "string", "maxLength": 60 },
            "focusable": { "type": "boolean" },
            "notes": { "type": "string", "maxLength": 500 }
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "sourceKey": { "type": "string", "maxLength": 200 },
            "sourceBlock": { "type": "string", "maxLength": 80 },
            "sourceRevisionHash": { "type": "string", "maxLength": 71 }
          }
        }
      }
    }
  }
}
