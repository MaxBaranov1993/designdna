{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://designai.dev/motion-ir/1.0",
  "title": "MotionIR",
  "type": "object",
  "required": ["version", "source", "composition", "scenes", "tracks", "markers", "assets", "renderSettings"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "source": {
      "type": "object",
      "required": ["interactionHash", "baseDesignIrHash"],
      "additionalProperties": false,
      "properties": {
        "interactionHash": { "type": "string", "minLength": 16 },
        "baseDesignIrHash": { "type": "string", "minLength": 16 }
      }
    },
    "composition": {
      "type": "object",
      "required": ["width", "height", "fps", "duration", "background"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 240, "maximum": 2160 },
        "fps": { "type": "integer", "minimum": 12, "maximum": 60 },
        "duration": { "type": "integer", "minimum": 0 },
        "background": { "type": "string" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "interactionSceneId", "start", "duration", "viewport", "transition"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "interactionSceneId": { "type": "string", "minLength": 1 },
          "start": { "type": "integer", "minimum": 0 },
          "duration": { "type": "integer", "minimum": 250, "maximum": 30000 },
          "viewport": { "enum": ["desktop", "tablet", "mobile"] },
          "transition": {
            "type": "object",
            "required": ["type", "duration", "easing"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["cut", "fade", "slide-left", "slide-up", "zoom"] },
              "duration": { "type": "integer", "minimum": 0, "maximum": 30000 },
              "easing": { "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out"] }
            }
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "clips", "locked"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "type": { "enum": ["scene", "cursor", "camera", "overlay", "audio"] },
          "name": { "type": "string" }, "locked": { "type": "boolean" },
          "clips": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "markers": { "type": "array", "items": { "type": "object" } },
    "assets": { "type": "array", "items": { "type": "object" } },
    "layers": {
      "type": "array",
      "description": "Компоненты страницы как слои композиции (After Effects-модель).",
      "items": { "$ref": "#/$defs/compLayer" }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keyframes": {
          "type": "array",
          "items": { "$ref": "#/$defs/compKeyframe" }
        }
      }
    },
    "renderSettings": {
      "type": "object",
      "required": ["format", "codec", "quality"],
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["mp4", "webm"] }, "codec": { "enum": ["h264", "vp9"] },
        "quality": { "enum": ["draft", "high", "lossless"] }
      }
    }
  },
  "$defs": {
    "compKeyframe": {
      "type": "object",
      "required": ["t"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "type": "number", "minimum": 0.05, "maximum": 8 },
        "rotate": { "type": "number" }
      }
    },
    "compLayer": {
      "type": "object",
      "required": ["id", "name", "sectionIndex", "enabled", "keyframes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "sectionIndex": { "type": "integer", "minimum": 0 },
        "sourceKey": { "type": "string" },
        "enabled": { "type": "boolean" },
        "keyframes": {
          "type": "array",
          "items": { "$ref": "#/$defs/compKeyframe" }
        }
      }
    }
  }
}
