{
  "name": "designai-flow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DesignAI node editor on SvelteKit and Svelte Flow",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-check && vite build && vite build --config vite.engine.config.ts",
    "build:engine": "vite build --config vite.engine.config.ts",
    "preview": "vite preview",
    "build:desktop": "npm run build",
    "check": "svelte-kit sync && svelte-check"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@xyflow/svelte": "^1.2.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
